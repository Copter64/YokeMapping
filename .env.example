# Copy this file to `.env` and fill in real values for your machine.
# `.env` itself is gitignored — never commit real secrets/paths here.
# Precedence: defaults < yokemapping.toml < .env < real environment variables.

# Logging (DEBUG, INFO, WARNING, ERROR, CRITICAL). Leave LOG_DIR empty for console only.
YOKEMAPPING_LOG_LEVEL=INFO
YOKEMAPPING_LOG_DIR=

# SimConnect / MSFS2024 connection (defaults are usually fine for a local install)
YOKEMAPPING_SIMCONNECT_HOST=localhost
YOKEMAPPING_SIMCONNECT_PORT=500

# SteamVR / OpenVR
YOKEMAPPING_STEAMVR_CAMERA_INDEX=0

# Calibration profile storage location (see docs/ROADMAP.md Phase 6)
YOKEMAPPING_CALIBRATION_PROFILE_DIR=./calibration_profiles
